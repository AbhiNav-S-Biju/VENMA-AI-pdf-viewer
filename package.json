{
  "name": "venma-pdf-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env server/index.mjs",
    "dev:full": "concurrently -k \"npm run dev\" \"npm run dev:server\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:pdf": "node tests/pdf-smoke.mjs",
    "test:ai": "node tests/ai-api.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2"
  }
}
