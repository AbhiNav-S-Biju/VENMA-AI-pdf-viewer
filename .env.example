# Server-only AI provider configuration. Copy this file to .env and fill in what you use.
# .env is gitignored. Never put a key in a VITE_* variable: those are bundled into the
# extension and anyone can read them. Run `npm run check:secrets` before pushing.
#
# Any provider left blank (or still "replace-with-...") is simply skipped.
# "Auto" in the assistant picks the first reachable model, in AI_MODEL_PRIORITY order.

# ── Free, open-source, no key: Ollama on this computer ─────────────────────
# Install from https://ollama.com, run `ollama pull llama3.1` (or qwen2.5, gemma2, mistral...),
# then set the model name here. Nothing leaves your machine.
OLLAMA_MODEL=llama3.1
# OLLAMA_API_URL=http://127.0.0.1:11434/v1/chat/completions

# ── Free cloud tiers (sign up for a key; open-weight models) ───────────────
# OpenRouter: free model IDs end in ":free" (see https://openrouter.ai/models?q=free).
# Roughly 20 requests/minute and 50/day on a free account.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=replace-with-an-openrouter-model-id-ending-in-:free
# Groq: free tier, about 30 requests/minute; model IDs at https://console.groq.com/docs/models
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-your-documented-groq-model-id
# Google AI Studio (Gemini): free tier with daily limits.
GEMINI_API_KEY=replace-with-your-google-ai-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=replace-with-your-documented-gemini-model-id

# ── Self-hosted Gemma on a temporary Kaggle tunnel ─────────────────────────
GEMMA_ENDPOINT=https://your-kaggle-quick-tunnel.example/v1/chat/completions
GEMMA_API_KEY=replace-with-your-gemma-server-key
GEMMA_MODEL=replace-with-your-configured-gemma-model-id

# Optional exact model IDs in preferred order, comma-separated, e.g. ollama:llama3.1
AI_MODEL_PRIORITY=
# Health status cache and probe timeout.
AI_HEALTH_TTL_MS=30000
AI_HEALTH_TIMEOUT_MS=2500
# Local models on a laptop CPU can take a minute or more; keep this generous.
AI_REQUEST_TIMEOUT_MS=120000
# Legacy single-provider variables remain supported for local migration only.
# AI_API_KEY=
# AI_API_URL=
# AI_MODEL=
PORT=3001
# Comma-separated exact origins. Add your unpacked extension origin when testing from Chrome.
CORS_ORIGINS=http://127.0.0.1:5173,chrome-extension://your-extension-id
VITE_ASSISTANT_API_URL=http://127.0.0.1:3001/api
